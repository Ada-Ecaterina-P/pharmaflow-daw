        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    classDef usuario fill:#f0f9ff,stroke:#7dd3fc,stroke-width:2px,color:#0c4a6e,rx:8,ry:8\n    classDef seguridad fill:#d1fae5,stroke:#34d399,stroke-width:2px,color:#065f46,font-weight:bold\n    classDef modulo fill:#ecfdf5,stroke:#6ee7b7,stroke-width:1.5px,color:#065f46,rx:8,ry:8\n    classDef opcional fill:#f8fafc,stroke:#94a3b8,stroke-width:1.5px,stroke-dasharray: 5 5,color:#475569,rx:8,ry:8\n    classDef externo fill:#e0f2fe,stroke:#38bdf8,stroke-width:2px,color:#0369a1\n\n    subgraph Usuarios[\&quot;1. Perfiles de Usuario (Acceso RBAC)\&quot;]\n        direction LR\n        U1[\&quot;Titular / Manager&lt;br/&gt;(Control total y analítica)\&quot;]:::usuario\n        U2[\&quot;Técnico en Mostrador&lt;br/&gt;(POS, clientes y CIMA)\&quot;]:::usuario\n        U3[\&quot;Personal de Almacén&lt;br/&gt;(Albaranes y stock)\&quot;]:::usuario\n    end\n\n    subgraph Core[\&quot;2. Plataforma Web PharmaFlow\&quot;]\n        direction TB\n        SEC[\&quot;Módulo de Seguridad (RBAC) y Auditoría RGPD\&quot;]:::seguridad\n\n        subgraph Modulos[\&quot;Núcleo Prioritario (MVP)\&quot;]\n            direction LR\n            M1[\&quot;Punto de Venta (POS)&lt;br/&gt;y Dashboard\&quot;]:::modulo\n            M2[\&quot;CRM y Fidelización&lt;br/&gt;(Descuentos y Fianzas)\&quot;]:::modulo\n            M3[\&quot;Inventario FEFO&lt;br/&gt;(CN, Lotes y Albaranes)\&quot;]:::modulo\n            M4[\&quot;Conector CIMA&lt;br/&gt;(Prospectos y Stock)\&quot;]:::modulo\n        end\n\n        subgraph Ampliacion[\&quot;Módulos de Ampliación Opcional\&quot;]\n            direction LR\n            A1[\&quot;Asistente IA&lt;br/&gt;(Resumen CIMA)\&quot;]:::opcional\n            A2[\&quot;Notificaciones&lt;br/&gt;WhatsApp\&quot;]:::opcional\n        end\n    end\n\n    subgraph Externo[\&quot;3. Persistencia y Servicios Externos\&quot;]\n        direction LR\n        DB[(\&quot;Base de Datos Relacional&lt